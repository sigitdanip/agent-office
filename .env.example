# Agent Office — config

# Mode 1: VPS Standalone (runs where kanban DB lives)
# The server reads the Hermes kanban database directly.
# PORT=3000
# KANBAN_DB=/root/.hermes/kanban.db
# POLL_INTERVAL=2000

# Mode 2: Remote Client (Windows / local machine)
# Serve the UI locally, connect to a VPS backend for data.
# No native compilation needed — works on any OS.
# PORT=3000
# REMOTE_BACKEND=http://187.77.130.62:3000
